{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173
    },
    {
      "name": "game-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@otp/game", "exec", "vite", "--port", "5199", "--strictPort"],
      "port": 5199
    },
    {
      "name": "production",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@otp/game",
        "exec",
        "sh",
        "-c",
        "vite build --outDir dist-preview && vite preview --outDir dist-preview --port 4180 --strictPort"
      ],
      "port": 4180
    }
  ]
}
